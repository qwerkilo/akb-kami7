{
  "name": "akb-kami7",
  "version": "0.0.0",
  "private": true,
  "description": "AKB KAMI7 static site",
  "scripts": {
    "test": "node --test && python3 -m unittest discover -s scripts -t scripts -p 'test_*.py'",
    "graph:sync": "codegraph sync -q",
    "prepare": "husky",
    "check": "npm run format:check && npm test && npm run complexity",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check .",
    "complexity": "node scripts/complexity.mjs",
    "e2e": "node e2e/e2e.cjs",
    "e2e:v5": "node e2e/e2e-v5.cjs",
    "e2e:pwa": "node e2e/e2e-pwa.cjs",
    "e2e:header": "node e2e/verify-header.cjs"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.9"
  }
}
